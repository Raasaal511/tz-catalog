# === Shared ===
INTERNAL_API_KEY=dev-internal-key

# === Telegram bot ===
BOT_TOKEN=123456:replace-me
# Your Telegram numeric user id(s), comma-separated
ADMIN_TELEGRAM_IDS=123456789
# URL of the Next.js catalog (must be HTTPS for real Telegram Mini App)
WEBAPP_URL=http://localhost:3000

# polling for local docker-compose; webhook for Render / multi-instance
BOT_MODE=polling
WEBHOOK_HOST=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=dev-webhook-secret

# === Frontend build-time / runtime ===
# Browser / Telegram WebView talks to public API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side fetch inside Docker network
API_BASE_URL_INTERNAL=http://api:8000

CORS_ORIGINS=http://localhost:3000

# Public URL of the FastAPI service (used in product image links)
PUBLIC_BASE_URL=http://localhost:8000

# Optional local overrides when running API outside Docker:
# DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:15432/catalog
# S3_ENDPOINT_URL=http://localhost:19000
